{
  "manifest_version": 3,
  "name": "faststore-login-extension",
  "version": "0.1.0",
  "description": "Entre na loja em ambiente de teste com seu e-mail e um codigo, sem precisar copiar nada do DevTools.",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vtex.app/*",
    "https://*.myvtex.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "faststore-login-extension",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  }
}
