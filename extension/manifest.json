{
  "manifest_version": 3,
  "name": "Login de teste em lojas VTEX — Wicomm",
  "version": "1.0.0",
  "description": "Entre na loja em ambiente de teste com seu e-mail e um código. Ferramenta independente, sem vínculo com a VTEX.",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.vtex.app/*",
    "https://*.myvtex.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Login de teste em lojas VTEX",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png",
      "48": "icones/48.png",
      "128": "icones/128.png"
    }
  }
}
